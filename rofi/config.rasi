configuration {
    show-icons:      true;
    display-drun:    " ";
    drun-display-format: "{name}";
    font:            "CaskaydiaCove Nerd Font 14";
}

/* Rofi prefiere @theme en lugar de @import */
@theme "/home/hyperZen/.config/matugen/output/colors.rasi"

* {
    /* Inyectamos las variables dinámicas de Matugen */
    bg:          @m-bg;
    bg-selected: @m-bg-selected;
    fg:          @m-fg;
    accent:      @m-accent;
    
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    background-color: @bg;
    padding:          10px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    /* Usamos el fondo especial para el input */
    background-color: @m-input-bg; 
    border-radius: 8px;
    padding: 10px;
}

prompt {
    text-color: @accent;
    margin: 0 10px 0 0;
}

entry {
    placeholder: "Search...";
    /* Usamos el color de placeholder dinámico */
    placeholder-color: @m-placeholder;
}

listview {
    lines:      8;
    columns:    1;
    fixed-height: false;
}

element {
    padding:       8px;
    border-radius: 8px;
    spacing:       10px;
}

element selected {
    background-color: @bg-selected;
    text-color:       @accent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
